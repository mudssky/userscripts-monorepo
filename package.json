{
  "name": "userscripts-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "pnpm monorepo for userscript projects.",
  "scripts": {
    "build": "pnpm --filter ./userscripts/* run build",
    "build:highlight-keywords": "pnpm --filter highlight-keywords run build",
    "dev:highlight-keywords": "pnpm --filter highlight-keywords run dev",
    "preview:highlight-keywords": "pnpm --filter highlight-keywords run preview",
    "subtree": "tsx scripts/subtree-cli/index.ts",
    "subtree:pull": "tsx scripts/subtree-cli/index.ts pull",
    "subtree:push": "tsx scripts/subtree-cli/index.ts push",
    "subtree:list": "tsx scripts/subtree-cli/index.ts list",
    "subtree:status": "tsx scripts/subtree-cli/index.ts status",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "keywords": [
    "userscript",
    "monorepo"
  ],
  "author": "mudssky",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.6.2",
    "biome": "^0.3.3",
    "commander": "^14.0.3",
    "execa": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.0"
}
