{
  "name": "userscripts-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "pnpm monorepo for userscript projects.",
  "scripts": {
    "build": "turbo run build",
    "build:highlight-keywords": "pnpm --filter highlight-keywords run build",
    "dev:highlight-keywords": "pnpm --filter highlight-keywords run dev",
    "preview:highlight-keywords": "pnpm --filter highlight-keywords run preview",
    "subtree": "tsx scripts/subtree-cli/index.ts",
    "subtree:pull": "tsx scripts/subtree-cli/index.ts pull",
    "subtree:push": "tsx scripts/subtree-cli/index.ts push",
    "subtree:list": "tsx scripts/subtree-cli/index.ts list",
    "subtree:status": "tsx scripts/subtree-cli/index.ts status",
    "typecheck": "turbo run typecheck",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build",
    "prepare": "husky"
  },
  "keywords": [
    "userscript",
    "monorepo"
  ],
  "author": "mudssky",
  "license": "ISC",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.3",
    "biome": "^0.3.3",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
