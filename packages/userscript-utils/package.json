{
  "name": "@mudssky/userscript-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "userscript monorepo 共享工具库",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:run": "vitest run",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "biome:check": "biome check .",
    "qa": "pnpm typecheck && pnpm biome:check && pnpm test"
  }
}
