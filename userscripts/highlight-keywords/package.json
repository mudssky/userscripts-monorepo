{
  "name": "highlight-keywords",
  "author": "mudssky",
  "license": "MIT",
  "private": true,
  "version": "3.2.3",
  "type": "module",
  "homepage": "https://github.com/mudssky/highlight-keywords",
  "description": "高亮关键词,可设置关键词的样式,支持正则匹配",
  "scripts": {
    "dev": "cross-env DEBUG_MODE=true vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "biome:check": "biome check .",
    "qa": "pnpm typecheck && pnpm biome:check && pnpm test"
  },
  "dependencies": {
    "@mudssky/jsutils": "^1.35.0",
    "@mudssky/userscript-utils": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "element-plus": "^2.14.1",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "cross-env": "^10.1.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "terser": "^5.48.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite-plugin-monkey": "8.0.6",
    "vue-tsc": "^3.3.4"
  }
}
